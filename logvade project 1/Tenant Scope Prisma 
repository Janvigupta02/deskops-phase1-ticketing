5. Authentication Middleware
File: src/middleware/auth.ts
import { Request, Response, NextFunction } from "express";

export interface AuthRequest extends Request {
  user?: {
    id: string;
    organisationId: string;
  };
}

export const authMiddleware = (
  req: AuthRequest,
  res: Response,
  next: NextFunction
) => {

  // User must be authenticated.
  // In production, populate this from a verified JWT/session.

  if (!req.user) {
    return res.status(401).json({
      message: "Unauthorized"
    });
  }

  next();
};
6. Ticket Controller
File: src/controllers/ticket.controller.ts
This is the most important part of your task.
import { Response } from "express";
import prisma from "../config/prisma";
import { AuthRequest } from "../middleware/auth";

export const getTicket = async (
  req: AuthRequest,
  res: Response
) => {

  try {

    const { id } = req.params;

    const organisationId = req.user?.organisationId;

    if (!organisationId) {
      return res.status(401).json({
        message: "Unauthorized"
      });
    }

    const ticket = await prisma.ticket.findFirst({
      where: {
        id: id,
        organisationId: organisationId
      }
    });

    if (!ticket) {
      return res.status(404).json({
        message: "Ticket not found"
      });
    }

    return res.status(200).json({
      success: true,
      data: ticket
    });

  } catch (error) {

    return res.status(500).json({
      message: "Internal server error"
    });

  }
};
Security point: Never fetch a ticket using only its ID. Always use both id and organisationId.
