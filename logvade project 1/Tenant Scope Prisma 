8. Automated Tenancy Test
File: tests/tenancy.test.ts
Using Vitest and Supertest:
import { describe, it, expect, vi } from "vitest";
import request from "supertest";
import app from "../src/app";
import prisma from "../src/config/prisma";

vi.mock("../src/config/prisma", () => ({
  default: {
    ticket: {
      findFirst: vi.fn()
    }
  }
}));

describe("Organisation Tenancy Security", () => {

  it("Org A should get 404 for Org B ticket", async () => {

    const ticketId = "ticket-org-b";

    vi.mocked(prisma.ticket.findFirst).mockResolvedValue(null);

    const response = await request(app)
      .get(`/api/tickets/${ticketId}`)
      .set("Authorization", "Bearer org-a-token");

    expect(response.status).toBe(404);

    expect(prisma.ticket.findFirst).toHaveBeenCalledWith({
      where: {
        id: ticketId,
        organisationId: "org-a"
      }
    });

  });

});
